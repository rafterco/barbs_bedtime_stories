rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Stories ──
    // Public read (published only), admin write
    match /stories/{storyId} {
      allow read: if resource.data.isPublished == true;
      allow read, write: if isAdmin();
    }

    // ── Playlists ──
    // Public read (published only), admin write
    match /playlists/{playlistId} {
      allow read: if resource.data.isPublished == true;
      allow read, write: if isAdmin();
    }

    // ── Categories ──
    // Public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── App Config ──
    // Public read, admin write
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Testimonials ──
    // Public read (published only), admin read/write
    match /testimonials/{testimonialId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // ── Users ──
    // Users can only read/write their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    // ── Admin ──
    // Only admins can read admin list, no client writes
    match /admin/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // managed via Firebase Console or Cloud Functions
    }

    // ── Default: deny all ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
